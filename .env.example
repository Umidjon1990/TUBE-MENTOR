# Required in production. Enter real values in your hosting service, never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_URL=https://your-domain.example
PORT=5000
TZ=UTC
DB_POOL_MAX=10

# Email signup, verification and password reset (Resend verified sender).
RESEND_API_KEY=
MAIL_FROM=TUBE MENTOR <hello@your-domain.example>
ALLOW_SIGNUP=true

# Google OAuth web application. Callback: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional content generation/transcription. Manual SRT/VTT + JSON import works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
YT_DLP_BINARY=yt-dlp

# One-time setup: npm run setup:admin. Remove ADMIN_PASSWORD after successful setup.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Local development only. Never enable on production.
ENABLE_DEMO_SEED=false
