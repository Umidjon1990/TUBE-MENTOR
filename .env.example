# Required in production. Enter real values in your hosting service, never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_URL=https://your-domain.example
PORT=5000
TZ=UTC
DB_POOL_MAX=10

# Email signup, verification and password reset (Resend verified sender).
RESEND_API_KEY=
MAIL_FROM=TUBE MENTOR <hello@your-domain.example>
ALLOW_SIGNUP=true

# Google OAuth web application. Callback: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login OIDC. BotFather Mini App > choose bot > Login Widget > Allowed URLs.
# Callback: APP_URL/api/auth/telegram/callback. These are login credentials, not the bot token.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Admin payment review bot. Separate from Telegram Login OIDC credentials.
# Configure allowed admin IDs, then pair an active site admin using Settings > Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
# Persist this directory on a private volume. Receipts must never be placed under /uploads.
PRIVATE_RECEIPTS_DIR=/app/private-payments/receipts

# Optional content generation/transcription. Manual SRT/VTT + JSON import works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
YT_DLP_BINARY=yt-dlp

# One-time setup: npm run setup:admin. Remove ADMIN_PASSWORD after successful setup.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Local development only. Never enable on production.
ENABLE_DEMO_SEED=false
